{
  "name": "generador-de-lettering",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && vite build --config vite.ssr.config.ts && node scripts/generate-static-heads.mjs && rm -rf dist-ssr",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-ssr server.js",
    "lint": "tsc --noEmit",
    "validate": "node scripts/validate-content.mjs",
    "validate:build": "node scripts/validate-build-output.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "konva": "^10.3.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-konva": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.15.0",
    "remark-gfm": "^4.0.1",
    "use-image": "^1.1.4",
    "vite": "^6.2.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
